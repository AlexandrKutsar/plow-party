{
  "openapi": "3.1.0",
  "info": {
    "title": "Plow Party API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness of the API and its database",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/login": {
      "post": {
        "tags": [
          "accounts"
        ],
        "summary": "Log in as a guest by Device Id",
        "description": "Creates the Account on the first login from a Device Id and returns it with a new Auth Token. Every call issues a new token and invalidates the previous one.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/me": {
      "get": {
        "tags": [
          "accounts"
        ],
        "summary": "The calling Account",
        "operationId": "get_me",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or superseded Auth Token"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "patch": {
        "tags": [
          "accounts"
        ],
        "summary": "Change the calling Account's Nickname",
        "description": "Nicknames are not unique; a rejected Nickname answers 422 naming the broken rule.",
        "operationId": "rename_me",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or superseded Auth Token"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountResponse": {
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Account Id",
            "description": "Public id of the Account"
          },
          "nickname": {
            "type": "string",
            "title": "Nickname",
            "description": "Display name shown in the HUD and the Tournament"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "nickname"
        ],
        "title": "AccountResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "LoginRequest": {
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid",
            "title": "Device Id",
            "description": "UUID the client generated once and keeps in local storage"
          }
        },
        "type": "object",
        "required": [
          "device_id"
        ],
        "title": "LoginRequest"
      },
      "LoginResponse": {
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Account Id",
            "description": "Public id of the Account"
          },
          "nickname": {
            "type": "string",
            "title": "Nickname",
            "description": "Display name shown in the HUD and the Tournament"
          },
          "token": {
            "type": "string",
            "title": "Token",
            "description": "Auth Token for the Authorization: Bearer header; replaces any earlier one"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "nickname",
          "token"
        ],
        "title": "LoginResponse"
      },
      "RenameRequest": {
        "properties": {
          "nickname": {
            "type": "string",
            "title": "Nickname",
            "description": "New Nickname: trimmed, 3-16 letters, digits, spaces, '_' or '-', no consecutive spaces"
          }
        },
        "type": "object",
        "required": [
          "nickname"
        ],
        "title": "RenameRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
